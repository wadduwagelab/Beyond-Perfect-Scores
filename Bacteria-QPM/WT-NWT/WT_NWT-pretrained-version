    "\n",
    "        if test_acc > best_acc:\n",
    "            best_acc = test_acc\n",
    "            best_epoch = epoch\n",
    "\n",
    "    print(f\"    [BEST] Epoch {best_epoch}: Test Acc = {best_acc:.2f}%\")\n",
    "    return best_acc / 100.0"
