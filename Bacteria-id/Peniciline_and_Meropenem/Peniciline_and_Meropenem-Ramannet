    "def prepare_data(X, y, batch_size=32, shuffle=True):\n",
    "    \"\"\"Convert numpy arrays to DataLoader with shape [B,1,L].\"\"\"\n",
    "    X_tensor = torch.as_tensor(X, dtype=torch.float32).unsqueeze(1)  # [N,1,L]\n",
